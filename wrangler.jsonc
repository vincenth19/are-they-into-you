{
  "name": "am-i-friendzoned",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Serves the built React app; requests that aren't files fall through to the worker.
  "assets": { "not_found_handling": "single-page-application" },
  // Workers AI, used to read screenshots.
  "ai": { "binding": "AI" },
  // Change or remove this if you deploy your own copy.
  "routes": [{ "pattern": "friendzone.vincenth19.com", "custom_domain": true }]
}
